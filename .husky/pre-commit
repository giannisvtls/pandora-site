# ESLint 10 + eslint-plugin-unicorn crash on Node < 24, and lint-staged then reverts the staged
# files. Stop early with a clear message instead.
node -e "process.exit(Number(process.versions.node.split('.')[0]) >= 24 ? 0 : 1)" || {
  echo "pre-commit: Node 24+ is required (PATH node is $(node -v)). Put Node 24 first on PATH." >&2
  exit 1
}

# Typed lint resolves astro:content through .astro/types.d.ts, which a fresh clone does not have
# (it is gitignored). Generate it first. This also runs the content loader over the WORKING-TREE
# snapshot (not the staged blob), so a broken snapshot on disk blocks the commit; CI's build is the
# check for what was actually committed.
node_modules/.bin/astro sync

lint-staged
