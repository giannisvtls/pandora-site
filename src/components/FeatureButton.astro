---
// A feature's explainer button (spec §8): `data-fx` names the feature, and the explainer island
// (Explainer.tsx, in the layout) opens its dialog from any such button on the page. Without
// JavaScript nothing can open it (A11): the button is hidden and the title beside it shows as
// plain text, so there is no control that does nothing.
interface Props {
  // The feature key (`gps`).
  feature: string;
  // The feature's title in the page's language.
  title: string;
}

const { feature, title } = Astro.props;
---

<button type="button" class="fx" data-fx={feature} aria-haspopup="dialog">
  {title}
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M12 11v5M12 8h.01"></path>
  </svg>
</button>
<span class="fx-text">{title}</span>

<style>
  /* nightwatch.css "feature explainers": a dotted underline and an info mark. The design resets
     the button with `all: unset`, which would also clear base.css's scroll margin and let the
     fixed header cover the button when it takes focus: the browser's button styles are reset one
     by one instead. */
  .fx {
    appearance: none;
    margin: 0;
    padding: 0 0 1px;
    border: 0;
    border-bottom: 1px dotted var(--ink-3);
    border-radius: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: inherit;
    text-transform: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 24px;
    transition:
      border-color 0.3s,
      color 0.3s;
  }

  .fx svg {
    width: 14px;
    height: 14px;
    color: var(--blue-soft);
    flex: none;
  }

  .fx:hover {
    border-bottom-style: solid;
    border-bottom-color: var(--ink);
    color: var(--ink);
  }

  /* The design's ring for these controls: a 3px offset. */
  .fx:focus-visible {
    outline: 2px solid var(--armed);
    outline-offset: 3px;
  }

  /* Without JavaScript (A11): the title as text, in place of the button that could not open. */
  .fx-text {
    display: none;
  }

  :global(html:not(.js)) .fx {
    display: none;
  }

  :global(html:not(.js)) .fx-text {
    display: inline;
  }
</style>
