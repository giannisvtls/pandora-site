---
// The site footer (spec §7): the company block, the link columns of the footer copy (a link with
// no URL yet and a column left without links are not rendered, A9) and the legal line. Everything
// it shows comes from `content` (layouts/shell.ts, through the query module).
import { Image } from 'astro:assets';

import logoWhite from '../assets/brand/invetec-logo-lettering-white.webp';
import logoDark from '../assets/brand/invetec-logo.webp';
import type { FooterContent } from '../layouts/shell';

interface Props {
  content: FooterContent;
}

const { content } = Astro.props;
const { company, columns } = content;
---

<footer class="ftr wrap">
  <div class="ftr-in">
    <div>
      <Image class="lw" src={logoWhite} alt={content.logoAlt} height={36} densities={[1, 2]} />
      <Image class="ld" src={logoDark} alt={content.logoAlt} height={36} densities={[1, 2]} />
      <address>
        <ul>
          <li>{company.name}</li>
          <li>{company.address}</li>
          <li>{company.hours}</li>
          <li>
            <a href={company.phone.href}>{company.phone.label}</a>
          </li>
          <li>
            <a href={company.email.href}>{company.email.label}</a>
          </li>
        </ul>
      </address>
    </div>
    {columns.map(({ heading, links }) => (
      <div>
        <h2>{heading}</h2>
        <ul>
          {links.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="legal">
    <span>{content.copyright}</span>
    <span>{content.tagline}</span>
  </div>
</footer>

<style>
  /* nightwatch.css "footer". The column headings are h2 (the page's sections are h2 too), styled
     as the design's small h4 labels in the body face. */
  .ftr {
    border-top: 1px solid var(--rule);
    padding-block: 64px 32px;
    background: var(--night);
  }

  .ftr-in {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr;
    gap: 40px;
  }

  .ftr img {
    height: 36px;
    width: auto;
    margin-bottom: 18px;
  }

  .ftr img.lw {
    display: var(--lw);
  }

  .ftr img.ld {
    display: var(--ld);
  }

  address {
    font-style: normal;
  }

  h2 {
    font-family: var(--body);
    font-size: 12px;
    line-height: 1.55;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 14px;
    font-weight: 700;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
    font-size: 15px;
    color: var(--ink-2);
  }

  a:hover {
    color: var(--ink);
  }

  .legal {
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid var(--rule-2);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--ink-3);
  }

  @media (max-width: 1100px) {
    .ftr-in {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }

  @media (max-width: 820px) {
    .ftr-in {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
