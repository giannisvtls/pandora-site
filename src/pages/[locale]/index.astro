---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import ProductSummary from '../../components/ProductSummary.astro';
import { siteQuery } from '../../content/query';
import BaseLayout from '../../layouts/BaseLayout.astro';

// One page per built language (the live ones), from the query module (P1-1).
export const getStaticPaths = (async () => {
  const query = await siteQuery();
  return query.staticPaths('home');
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale } = Astro.props as Props;
// The products visible in this language (the publish rules applied).
const query = await siteQuery();
const products = query.products(locale);
---

<BaseLayout lang={locale} title="INVETEC — Pandora vehicle security">
  <h1>Your car is not going anywhere without you.</h1>
  {products.map((product) => (
    <ProductSummary product={product} locale={locale} />
  ))}
</BaseLayout>
