---
import type { GetStaticPaths, InferGetStaticParamsType } from 'astro';

// Phase 0 builds only the English tree; the other locales are added when their content exists.
export const getStaticPaths = (() => [{ params: { locale: 'en' } }]) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;

const { locale } = Astro.params as Params;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>INVETEC</title>
  </head>
  <body>
    <main>
      <h1>INVETEC</h1>
    </main>
  </body>
</html>
